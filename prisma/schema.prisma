generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  username         String?   @unique
  email            String    @unique
  emailVerified    DateTime?
  hashedPassword   String?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLogin        DateTime?
  subscriptionTier String    @default("free")

  accounts    Account[]
  sessions    Session[]
  watchlist   WatchlistItem[]
  preferences UserPreferences?
  searches    RecentSearch[]
  aiHistory   AIHistoryEntry[]
  resetTokens PasswordResetToken[]
  portfolio   Portfolio?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model WatchlistItem {
  id       String   @id @default(cuid())
  userId   String
  ticker   String
  name     String
  exchange String   @default("NSE")
  sector   String?
  addedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@map("watchlist_items")
}

model UserPreferences {
  id            String  @id @default(cuid())
  userId        String  @unique
  theme         String  @default("dark")
  defaultTab    String  @default("overview")
  alertsEnabled Boolean @default(true)
  emailNotifs   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RecentSearch {
  id         String   @id @default(cuid())
  userId     String
  query      String
  ticker     String?
  searchedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@map("recent_searches")
}

model AIHistoryEntry {
  id          String   @id @default(cuid())
  userId      String
  ticker      String
  companyName String?
  verdict     String?
  confidence  Int?
  summary     String?  @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_history")
}

model Portfolio {
  id        String             @id @default(cuid())
  userId    String             @unique
  name      String             @default("My Portfolio")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  holdings  PortfolioHolding[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model PortfolioHolding {
  id          String    @id @default(cuid())
  portfolioId String
  ticker      String
  name        String
  exchange    String    @default("NSE")
  sector      String?
  quantity    Float
  avgPrice    Float
  notes       String?
  addedAt     DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, ticker])
  @@map("portfolio_holdings")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  used    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
