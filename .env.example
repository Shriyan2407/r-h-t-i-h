# Copy to .env.local (never commit real values). Every variable the app reads is listed here.
# "Required" means the feature fails closed without it - it is not silently skipped.

# ── Core (required) ──────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase/Neon/self-hosted). Prisma reads this.
DATABASE_URL="postgresql://user:password@localhost:5432/marketkabaadshah"
# Signs session JWTs. Generate with: openssl rand -base64 32  — use a DIFFERENT value per environment.
NEXTAUTH_SECRET=""
# Public origin of the app. Must be https in production. Used for auth callbacks.
NEXTAUTH_URL="http://localhost:3000"
# Origin used in links inside emails. Falls back to NEXTAUTH_URL. https required in production.
APP_URL=""

# ── Email (required in production) ───────────────────────────────────────────
# Verification and password-reset emails go through Resend (https://resend.com).
# In development, with these unset, the message is printed to the server console.
# In production, with these unset, signup and reset FAIL rather than silently drop mail.
RESEND_API_KEY=""
EMAIL_FROM="Market Ka Baadshah <no-reply@your-domain.example>"

# ── Rate limiting (strongly recommended in production) ──────────────────────
# Upstash Redis REST credentials make limits hold across serverless instances.
# Without them an in-memory per-instance limiter is used (a warning is logged).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: secret for detailed /api/health (falls back to CRON_SECRET). LOG_LEVEL: debug|info|warn|error
HEALTH_SECRET=""
LOG_LEVEL=""

# ── Cron + Telegram (required if alerts are used) ───────────────────────────
# Both fail CLOSED when unset: the endpoints answer 503 instead of accepting requests.
# Generate each with: openssl rand -hex 32
CRON_SECRET=""
# Telegram only allows [A-Za-z0-9_-], 1-256 chars for the webhook secret.
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# ── Web Push (optional) ──────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:you@example.com"

# ── Google sign-in (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Shows the Google button on the login page.
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ── AI narrative (optional; the app works without any of these) ──────────────
# Claude is used only if a key is set. Ollama only works where it is reachable
# (your machine / your server) — it cannot run on Vercel.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL=""
# Opt-in. Leave unset in production; set for local dev, e.g. http://localhost:11434
OLLAMA_BASE_URL=""

# ── Data providers (optional; public RSS feeds work with no keys) ───────────
NEWSAPI_KEY=""
FINNHUB_API_KEY=""
STOCKTWITS_TOKEN=""

# ── Cache TTLs in seconds (optional) ─────────────────────────────────────────
CACHE_TTL_INTELLIGENCE="1200"
CACHE_TTL_NEWS="600"
CACHE_TTL_SENTIMENT="300"
CACHE_TTL_MARKET="60"

# ── Development only ─────────────────────────────────────────────────────────
# Replace failed API calls with generated sample data and show a "DEMO DATA" banner.
# Ignored in production builds.
NEXT_PUBLIC_DEMO_MODE="false"
# Scratch database for `npm run test:integration` — NEVER point this at real data.
TEST_DATABASE_URL=""
