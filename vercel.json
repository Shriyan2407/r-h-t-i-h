{
  "name": "market-ka-baadshah",
  "framework": "nextjs",
  "alias": ["market-ka-baadshah.vercel.app"],
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "app/api/ai-analysis/[ticker]/route.ts":   { "maxDuration": 60 },
    "app/api/intelligence/[ticker]/route.ts":  { "maxDuration": 60 },
    "app/api/history/[ticker]/route.ts":       { "maxDuration": 60 },
    "app/api/technicals/[ticker]/route.ts":    { "maxDuration": 30 },
    "app/api/fundamentals/[ticker]/route.ts":  { "maxDuration": 30 },
    "app/api/news/[ticker]/route.ts":          { "maxDuration": 30 },
    "app/api/telegram/webhook/route.ts":       { "maxDuration": 30 },
    "app/api/cron/daily-briefing/route.ts":    { "maxDuration": 60 },
    "app/api/cron/market-alerts/route.ts":     { "maxDuration": 60 },
    "app/api/cron/news-alerts/route.ts":       { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "30 3 * * 1-5"
    },
    {
      "path": "/api/cron/market-alerts",
      "schedule": "0 4 * * 1-5"
    },
    {
      "path": "/api/cron/market-alerts",
      "schedule": "0 6 * * 1-5"
    },
    {
      "path": "/api/cron/market-alerts",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/market-alerts",
      "schedule": "45 9 * * 1-5"
    },
    {
      "path": "/api/cron/news-alerts",
      "schedule": "30 4 * * 1-5"
    },
    {
      "path": "/api/cron/news-alerts",
      "schedule": "30 6 * * 1-5"
    },
    {
      "path": "/api/cron/news-alerts",
      "schedule": "30 8 * * 1-5"
    }
  ]
}
